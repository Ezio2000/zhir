{
  "$defs": {
    "ResourceRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "type": "object"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/ResourceSource"
        }
      },
      "required": [
        "id",
        "media_type",
        "source",
        "metadata"
      ],
      "type": "object"
    },
    "ResourceSource": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "items": {
                "format": "uint8",
                "maximum": 255,
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            },
            "kind": {
              "const": "inline",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "bytes"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "url",
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "url"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string"
            },
            "kind": {
              "const": "stored",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "key"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "provider",
              "type": "string"
            },
            "provider": {
              "type": "string"
            },
            "reference": true
          },
          "required": [
            "kind",
            "provider",
            "reference"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "An immutable archive node. Completed or interrupted streams leave the active\ncursor table; their resources remain reachable from the session archive root.",
  "properties": {
    "complete": {
      "type": "boolean"
    },
    "previous": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResourceRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "sealed": {
      "$ref": "#/$defs/ResourceRef"
    },
    "stream_key": {
      "type": "string"
    }
  },
  "required": [
    "stream_key",
    "sealed",
    "complete"
  ],
  "title": "ArchivedMedia",
  "type": "object"
}
