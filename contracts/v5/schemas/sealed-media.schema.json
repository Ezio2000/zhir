{
  "$defs": {
    "ResourceRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "type": "object"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/ResourceSource"
        }
      },
      "required": [
        "id",
        "media_type",
        "source",
        "metadata"
      ],
      "type": "object"
    },
    "ResourceSource": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "items": {
                "format": "uint8",
                "maximum": 255,
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            },
            "kind": {
              "const": "inline",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "bytes"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "url",
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "url"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string"
            },
            "kind": {
              "const": "stored",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "key"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "provider",
              "type": "string"
            },
            "provider": {
              "type": "string"
            },
            "reference": true
          },
          "required": [
            "kind",
            "provider",
            "reference"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One immutable node in a sealed media stream. `previous` links to another node,\nkeeping checkpoint size independent of the stream duration.",
  "properties": {
    "end": {
      "type": "boolean"
    },
    "epoch": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "previous": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResourceRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "resource": {
      "$ref": "#/$defs/ResourceRef"
    },
    "sequence": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "session_id": {
      "type": "string"
    },
    "stream_id": {
      "type": "string"
    },
    "timestamp_us": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "stream_id",
    "session_id",
    "epoch",
    "sequence",
    "timestamp_us",
    "end",
    "resource"
  ],
  "title": "SealedMedia",
  "type": "object"
}
