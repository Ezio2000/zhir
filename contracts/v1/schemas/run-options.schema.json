{
  "$defs": {
    "Limits": {
      "additionalProperties": false,
      "properties": {
        "commit_timeout_ms": {
          "default": 5000,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "elapsed_ms": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_buffered_progress": {
          "default": 256,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "max_planning_steps": {
          "default": 100,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "max_progress_events": {
          "default": 256,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "max_runtime_tool_batch_size": {
          "default": 32,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "max_runtime_tool_calls": {
          "default": 1000,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "max_runtime_tool_concurrency": {
          "default": 8,
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "max_total_tokens": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ModelOptions": {
      "additionalProperties": false,
      "properties": {
        "extra": {
          "additionalProperties": true,
          "default": {},
          "type": "object"
        },
        "max_output_tokens": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "parallel_runtime_tools": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "seed": {
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "temperature": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ProviderToolSpec": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "options": {
          "default": null
        },
        "provider": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "name"
      ],
      "type": "object"
    },
    "ResponseFormat": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "json",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "schema",
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "schema": true
          },
          "required": [
            "kind",
            "name",
            "schema"
          ],
          "type": "object"
        }
      ]
    },
    "ToolChoice": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "auto",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "none",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "required",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "runtime_tool",
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "provider_tool",
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "provider": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "provider",
            "name"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Effective parameters frozen when a run starts and persisted with every checkpoint.",
  "properties": {
    "limits": {
      "$ref": "#/$defs/Limits"
    },
    "model": {
      "$ref": "#/$defs/ModelOptions"
    },
    "provider_tools": {
      "items": {
        "$ref": "#/$defs/ProviderToolSpec"
      },
      "type": "array"
    },
    "response_format": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResponseFormat"
        },
        {
          "type": "null"
        }
      ]
    },
    "stream": {
      "type": "boolean"
    },
    "tool_choice": {
      "$ref": "#/$defs/ToolChoice"
    }
  },
  "required": [
    "limits",
    "model",
    "provider_tools",
    "tool_choice",
    "stream"
  ],
  "title": "RunOptions",
  "type": "object"
}
