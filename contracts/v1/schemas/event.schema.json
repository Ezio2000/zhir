{
  "$defs": {
    "ApprovalDecisionKind": {
      "enum": [
        "allow",
        "deny",
        "suspend"
      ],
      "type": "string"
    },
    "ControlAction": {
      "enum": [
        "failed",
        "limited",
        "suspended"
      ],
      "type": "string"
    },
    "EventData": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "model_started",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "model_finished",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "call_id": {
              "type": "string"
            },
            "kind": {
              "const": "approval_requested",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "call_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "call_id": {
              "type": "string"
            },
            "decision": {
              "$ref": "#/$defs/ApprovalDecisionKind"
            },
            "kind": {
              "const": "approval_decided",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "call_id",
            "decision"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "call_id": {
              "type": "string"
            },
            "kind": {
              "const": "runtime_tool_cancel_requested",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "call_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "delta": {
              "$ref": "#/$defs/ModelDelta"
            },
            "kind": {
              "const": "model_delta",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "delta"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "call_id": {
              "type": "string"
            },
            "kind": {
              "const": "runtime_tool_started",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "call_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "call_id": {
              "type": "string"
            },
            "kind": {
              "const": "runtime_tool_progress",
              "type": "string"
            },
            "value": true
          },
          "required": [
            "kind",
            "call_id",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "call_id": {
              "type": "string"
            },
            "kind": {
              "const": "runtime_tool_finished",
              "type": "string"
            },
            "outcome": {
              "$ref": "#/$defs/RuntimeToolOutcomeKind"
            }
          },
          "required": [
            "kind",
            "call_id",
            "outcome"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "checkpoint_id": {
              "type": "string"
            },
            "fact": {
              "$ref": "#/$defs/Fact"
            },
            "kind": {
              "const": "checkpoint_committed",
              "type": "string"
            },
            "revision": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "state": {
              "$ref": "#/$defs/StateKind"
            }
          },
          "required": [
            "kind",
            "checkpoint_id",
            "revision",
            "state",
            "fact"
          ],
          "type": "object"
        }
      ]
    },
    "Fact": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "started",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "resumed",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "model_turn",
              "type": "string"
            },
            "result": {
              "$ref": "#/$defs/StateKind"
            },
            "runtime_tool_call_ids": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "runtime_tool_call_ids",
            "result"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "call_ids": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "kind": {
              "const": "runtime_tool_batch",
              "type": "string"
            },
            "outcomes": {
              "items": {
                "$ref": "#/$defs/RuntimeToolOutcomeKind"
              },
              "type": "array"
            },
            "parallel": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "call_ids",
            "outcomes",
            "parallel"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "conversation_insert",
              "type": "string"
            },
            "source": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "source"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "history_rewrite",
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "action": {
              "$ref": "#/$defs/ControlAction"
            },
            "kind": {
              "const": "control",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "action"
          ],
          "type": "object"
        }
      ]
    },
    "ModelDelta": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "text",
              "type": "string"
            },
            "output_index": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "output_index",
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "reasoning",
              "type": "string"
            },
            "output_index": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "output_index",
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "input": {
              "type": "string"
            },
            "kind": {
              "const": "runtime_tool",
              "type": "string"
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "output_index": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "output_index",
            "input"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "data": true,
            "kind": {
              "const": "protocol_event",
              "type": "string"
            },
            "output_index": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "output_index",
            "data"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "data": true,
            "id": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "const": "provider_tool_progress",
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "output_index": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "provider": {
              "type": "string"
            },
            "status": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ProviderToolStatus"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "output_index",
            "provider",
            "name",
            "data"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "usage",
              "type": "string"
            },
            "usage": {
              "$ref": "#/$defs/Usage"
            }
          },
          "required": [
            "kind",
            "usage"
          ],
          "type": "object"
        }
      ]
    },
    "ProviderToolStatus": {
      "enum": [
        "pending",
        "running",
        "completed",
        "incomplete",
        "failed"
      ],
      "type": "string"
    },
    "RuntimeToolOutcomeKind": {
      "enum": [
        "success",
        "failure",
        "accepted",
        "waiting"
      ],
      "type": "string"
    },
    "StateKind": {
      "enum": [
        "planning",
        "runtime_tools_pending",
        "suspended",
        "completed",
        "failed",
        "limited"
      ],
      "type": "string"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "cache_read_tokens": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "cache_write_tokens": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "input_tokens": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "output_tokens": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "reasoning_tokens": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "total_tokens": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "data": {
      "$ref": "#/$defs/EventData"
    },
    "invocation_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "sequence": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "run_id",
    "invocation_id",
    "sequence",
    "data"
  ],
  "title": "Event",
  "type": "object"
}
