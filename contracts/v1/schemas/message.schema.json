      "type": "object"
    },
    "ProviderToolStatus": {
      "enum": [
        "pending",
        "running",
        "completed",
        "incomplete",
        "failed"
      ],
      "type": "string"
    },
    "RuntimeToolCall": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "input": {
          "$ref": "#/$defs/RuntimeToolInput"
