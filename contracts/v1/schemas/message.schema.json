              "type": "string"
            }
          },
          "required": [
            "kind",
            "url"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "base64": {
              "type": "string"
            },
            "kind": {
              "const": "inline",
              "type": "string"
            },
            "mime_type": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "mime_type",
            "base64"
          ],
          "type": "object"
