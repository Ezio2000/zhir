          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "content": {
          "items": {
            "$ref": "#/$defs/Content"
          },
          "type": "array"
        },
        "role": {
          "const": "user",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "content": {
          "items": {
            "$ref": "#/$defs/Content"
          },
          "type": "array"
        },
        "role": {
          "const": "external",
          "type": "string"
        }
      },
      "required": [
        "role",
