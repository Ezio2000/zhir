          },
          "required": [
            "kind",
            "content",
            "structured"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "error": {
              "$ref": "#/$defs/Failure"
            },
            "kind": {
              "const": "failure",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "error"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "content": {
              "items": {
                "$ref": "#/$defs/Content"
              },
              "type": "array"
            },
            "kind": {
              "const": "accepted",
              "type": "string"
            },
            "structured": true,
            "task_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "task_id",
            "content",
            "structured"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "content": {
              "items": {
                "$ref": "#/$defs/Content"
              },
              "type": "array"
            },
            "kind": {
              "const": "waiting",
              "type": "string"
            },
            "structured": true,
            "wait_id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "wait_id",
            "content",
            "structured"
          ],
          "type": "object"
        }
      ]
    }
