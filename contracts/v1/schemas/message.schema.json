            },
            "kind": {
              "const": "content",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "content"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "call": {
              "$ref": "#/$defs/RuntimeToolCall"
            },
