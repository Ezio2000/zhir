            "source": {
              "$ref": "#/$defs/MediaSource"
            }
          },
          "required": [
            "kind",
            "source"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "audio",
              "type": "string"
            },
            "source": {
              "$ref": "#/$defs/MediaSource"
            }
          },
          "required": [
            "kind",
            "source"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "video",
              "type": "string"
            },
            "source": {
              "$ref": "#/$defs/MediaSource"
            }
          },
          "required": [
            "kind",
            "source"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "file",
              "type": "string"
