            "kind",
            "call"
          ],
          "type": "object"
        }
      ]
    },
    "ProviderToolCall": {
      "additionalProperties": false,
      "properties": {
        "data": {
          "default": null
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "output": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Content"
