          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "input"
      ],
      "type": "object"
    },
    "RuntimeToolInput": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "structured",
              "type": "string"
