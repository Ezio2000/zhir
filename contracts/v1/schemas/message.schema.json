        "output"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "call_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/RuntimeToolOutcome"
