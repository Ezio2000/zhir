              "const": "runtime_tool_call",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "call"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "call": {
              "$ref": "#/$defs/ProviderToolCall"
