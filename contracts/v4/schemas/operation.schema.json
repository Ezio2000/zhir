{
  "$defs": {
    "CallRef": {
      "additionalProperties": false,
      "properties": {
        "call_id": {
          "type": "string"
        },
        "caller_id": {
          "type": "string"
        },
        "generation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "item_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "item_id",
        "caller_id",
        "call_id"
      ],
      "type": "object"
    },
    "Content": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "text",
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "text"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "input": {
              "$ref": "#/$defs/ResourceInput"
            },
            "kind": {
              "const": "resource",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "input"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "data": true,
            "kind": {
              "const": "opaque",
              "type": "string"
            },
            "provider": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "provider",
            "data"
          ],
          "type": "object"
        }
      ]
    },
    "Failure": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "type": "object"
    },
    "Fidelity": {
      "enum": [
        "economy",
        "high",
        "original"
      ],
      "type": "string"
    },
    "OperationOutcome": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "content": {
              "items": {
                "$ref": "#/$defs/Content"
              },
              "type": "array"
            },
            "kind": {
              "const": "success",
              "type": "string"
            },
            "structured": true
          },
          "required": [
            "kind",
            "content",
            "structured"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "error": {
              "$ref": "#/$defs/Failure"
            },
            "kind": {
              "const": "failure",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "error"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "cancelled",
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "OperationOwner": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "runtime_tool",
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "provider",
              "type": "string"
            },
            "provider": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "provider"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "delegation",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ]
    },
    "OperationState": {
      "enum": [
        "queued",
        "running",
        "waiting",
        "cancelling",
        "succeeded",
        "failed",
        "cancelled",
        "unknown"
      ],
      "type": "string"
    },
    "OperationUpdate": {
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Durable context to be delivered to the model, distinct from UI progress.",
          "properties": {
            "content": {
              "items": {
                "$ref": "#/$defs/Content"
              },
              "type": "array"
            },
            "kind": {
              "const": "context",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "content"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "running",
              "type": "string"
            },
            "recovery": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RecoveryRef"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "waiting",
              "type": "string"
            },
            "prompt": true,
            "recovery": {
              "anyOf": [
                {
                  "$ref": "#/$defs/RecoveryRef"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "prompt"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "progress",
              "type": "string"
            },
            "value": true
          },
          "required": [
            "kind",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "finished",
              "type": "string"
            },
            "outcome": {
              "$ref": "#/$defs/OperationOutcome"
            }
          },
          "required": [
            "kind",
            "outcome"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "unknown",
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "RecoveryRef": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "type": "string"
        },
        "data": true
      },
      "required": [
        "adapter",
        "data"
      ],
      "type": "object"
    },
    "Requirement": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "strength": {
              "const": "required",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/Fidelity"
            }
          },
          "required": [
            "strength",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "strength": {
              "const": "preferred",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/Fidelity"
            }
          },
          "required": [
            "strength",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "ResourceInput": {
      "additionalProperties": false,
      "properties": {
        "resource": {
          "$ref": "#/$defs/ResourceRef"
        },
        "usage": {
          "$ref": "#/$defs/ResourceUsage"
        }
      },
      "required": [
        "resource",
        "usage"
      ],
      "type": "object"
    },
    "ResourceRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "media_type": {
          "type": "string"
        },
        "metadata": {
          "additionalProperties": true,
          "type": "object"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "$ref": "#/$defs/ResourceSource"
        }
      },
      "required": [
        "id",
        "media_type",
        "source",
        "metadata"
      ],
      "type": "object"
    },
    "ResourceSource": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "items": {
                "format": "uint8",
                "maximum": 255,
                "minimum": 0,
                "type": "integer"
              },
              "type": "array"
            },
            "kind": {
              "const": "inline",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "bytes"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "url",
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "url"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string"
            },
            "kind": {
              "const": "stored",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "key"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "provider",
              "type": "string"
            },
            "provider": {
              "type": "string"
            },
            "reference": true
          },
          "required": [
            "kind",
            "provider",
            "reference"
          ],
          "type": "object"
        }
      ]
    },
    "ResourceUsage": {
      "additionalProperties": false,
      "properties": {
        "extensions": {
          "additionalProperties": {
            "additionalProperties": true,
            "type": "object"
          },
          "type": "object"
        },
        "fidelity": {
          "anyOf": [
            {
              "$ref": "#/$defs/Requirement"
            },
            {
              "type": "null"
            }
          ]
        },
        "transforms": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "transforms",
        "extensions"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "call_entry": {
      "format": "uint",
      "minimum": 0,
      "type": "integer"
    },
    "id": {
      "type": "string"
    },
    "last_sequence": {
      "format": "uint64",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "last_update": {
      "anyOf": [
        {
          "$ref": "#/$defs/OperationUpdate"
        },
        {
          "type": "null"
        }
      ]
    },
    "origin": {
      "$ref": "#/$defs/CallRef"
    },
    "owner": {
      "$ref": "#/$defs/OperationOwner"
    },
    "recovery": {
      "anyOf": [
        {
          "$ref": "#/$defs/RecoveryRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "result_entry": {
      "format": "uint",
      "minimum": 0,
      "type": [
        "integer",
        "null"
      ]
    },
    "state": {
      "$ref": "#/$defs/OperationState"
    },
    "wait": true
  },
  "required": [
    "id",
    "origin",
    "owner",
    "state",
    "call_entry"
  ],
  "title": "OperationRecord",
  "type": "object"
}
