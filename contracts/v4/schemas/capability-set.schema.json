{
  "$defs": {
    "Capability": {
      "oneOf": [
        {
          "enum": [
            "structured_tools",
            "freeform_tools",
            "provider_tools",
            "parallel_tools",
            "parallel_control",
            "streaming",
            "usage",
            "structured_output",
            "json_mode",
            "seed",
            "duplex",
            "steering",
            "interrupt_output",
            "flush_input",
            "input_audio_control",
            "conversation_items",
            "delegation",
            "profile_updates",
            "async_results",
            "resume"
          ],
          "type": "string"
        },
        {
          "const": "explicit_generation",
          "description": "The host explicitly requests generation; opening never generates.",
          "type": "string"
        },
        {
          "const": "response_events",
          "description": "The protocol exposes real start/finish events and a verified input boundary.",
          "type": "string"
        },
        {
          "const": "local_projection",
          "description": "Context is local; rebuilding an idle projection has no remote session-creation effect.",
          "type": "string"
        },
        {
          "const": "replace_context",
          "description": "Context replacement is acknowledged before another generation may start.",
          "type": "string"
        },
        {
          "const": "streaming_input",
          "description": "A generation consumes a stream until the host seals its user input.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "constraints": {
      "additionalProperties": {
        "items": true,
        "type": "array"
      },
      "type": "object"
    },
    "extensions": {
      "additionalProperties": {
        "additionalProperties": true,
        "type": "object"
      },
      "type": "object"
    },
    "features": {
      "items": {
        "$ref": "#/$defs/Capability"
      },
      "type": "array",
      "uniqueItems": true
    },
    "input_modalities": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "output_modalities": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "tool_choices": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "input_modalities",
    "output_modalities",
    "features",
    "tool_choices",
    "constraints",
    "extensions"
  ],
  "title": "CapabilitySet",
  "type": "object"
}
