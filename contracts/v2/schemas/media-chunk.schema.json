{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bytes": {
      "items": {
        "format": "uint8",
        "maximum": 255,
        "minimum": 0,
        "type": "integer"
      },
      "type": "array"
    },
    "end": {
      "type": "boolean"
    },
    "epoch": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "media_type": {
      "type": "string"
    },
    "sequence": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "stream_id": {
      "type": "string"
    },
    "timestamp_us": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "turn_id": {
      "type": "string"
    }
  },
  "required": [
    "stream_id",
    "turn_id",
    "epoch",
    "sequence",
    "timestamp_us",
    "media_type",
    "bytes",
    "end"
  ],
  "title": "MediaChunk",
  "type": "object"
}
